---
import PWALayout from "../layouts/PWALayout.astro";
---

<PWALayout title="Home">
	<h1>Raspi!</h1>
	<button>Scan NFC</button>
</PWALayout>

<script>
	import { setup, scanNFC } from "../scripts/nfc";

	setup();

	document.querySelector("button")?.addEventListener("click", () => {
        scanNFC();
	});

</script>
