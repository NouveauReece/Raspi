---
import PWALayout from "../layouts/PWALayout.astro";
---

<PWALayout title="Home">
	<h1>Raspi!</h1>
	<button>Scan NFC</button>
</PWALayout>

<script>
	import { scanNFC } from "../scripts/nfc";
	document.querySelector("button")?.addEventListener("click", () => {
        scanNFC();
	});

	window.onNFCRead = (data) => {
		const p = document.createElement('p');
		p.innerText = data;
		document.body.appendChild(p);
	}
</script>
