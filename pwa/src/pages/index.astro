---
import PWALayout from '../layouts/PWALayout.astro'
---

<PWALayout title="Home">
    <h1>Raspi!</h1>
    <button>Scan NFC</button>
</PWALayout>

<script>
    import { scanNFC } from "../scripts/nfc";
    document.querySelector('button')?.addEventListener('click', () => {
        if (
        window.webkit &&
        window.webkit.messageHandlers &&
        window.webkit.messageHandlers.nfcScan
        ) {
        window.webkit.messageHandlers.nfcScan.postMessage(null);
        } else {
        console.log("nfcScan bridge not available");
        }
    }
)
</script>